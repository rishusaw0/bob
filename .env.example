# JEEVA AI Environment Variables (Copy to .env and fill real values — NEVER commit .env)

# Personal / Server Gemini API Key (Google AI Studio)
GEMINI_API_KEY=

# Optional Owner Admin PIN to protect shared Render proxy & workspace
APP_PIN=

# Optional Secret for signing session tokens (recommended on Render)
SESSION_SECRET=

# Optional Relay Secret for owner device authentication
RELAY_SECRET=

# Set true to lock the hosted web UI behind APP_PIN
PRIVATE_LOCK_ALL=false

# Per-IP Gemini proxy requests per minute limit
GEMINI_RPM_LIMIT=40

# Set true only behind a trusted reverse proxy that overwrites X-Forwarded-For
TRUST_PROXY=false

# Exact allowed browser origins for the hosted API (comma-separated override)
JEEVA_ALLOWED_ORIGINS=

# SHA-256 digest of the exact Windows installer advertised by /api/config
INSTALLER_SHA256=

# Optional persistent directory for SQLite / relay state on Render
DATA_DIR=

# Public Windows installer download URL (GitHub Releases / hosted .exe)
INSTALLER_DOWNLOAD_URL=

# LAN PC bridge: both TLS files are required to expose the bridge to your LAN.
# Without both files, the bridge binds to 127.0.0.1 only.
JEEVA_BRIDGE_TLS_CERT=
JEEVA_BRIDGE_TLS_KEY=
# Comma-separated exact origins allowed to call the local bridge (optional override)
JEEVA_BRIDGE_ALLOWED_ORIGINS=

# Optional default Render server URL baked into client build
VITE_RENDER_URL=
