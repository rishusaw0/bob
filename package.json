{
  "name": "jeeva-ai",
  "version": "1.0.1",
  "description": "JEEVA AI - Windows PC Desktop Assistant powered by local tools and Gemini",
  "main": "electron/main.cjs",
  "scripts": {
    "test": "node scripts/test.mjs",
    "dev": "concurrently \"npm run dev:react\" \"wait-on http://127.0.0.1:5173 && npm run dev:electron\"",
    "dev:react": "vite --host 127.0.0.1",
    "dev:electron": "electron .",
    "build": "npm run build:desktop",
    "build:desktop": "vite build --mode desktop && electron-builder --win nsis --publish never"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "author": "Roushan Kumar",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rishusaw0/bob.git"
  },
  "type": "module",
  "dependencies": {
    "@google/genai": "^3.5.0",
    "highlight.js": "^11.12.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.0",
    "postcss": "^8.4.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.2.1",
    "react-markdown": "^9.0.1",
    "tailwindcss": "^3.4.3",
    "vite": "^5.3.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.roushan.jeeva-ai",
    "productName": "JEEVA AI Desktop",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/icon.png",
      "public/icon.svg",
      "package.json"
    ],
    "asarUnpack": [
      "electron/*.ps1",
      "public/icon.png"
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "JEEVA AI",
      "deleteAppDataOnUninstall": false,
      "uninstallDisplayName": "JEEVA AI ${version}",
      "artifactName": "${productName} Setup ${version}.${ext}",
      "include": "build/installer.nsh"
    }
  },
  "allowScripts": {
    "protobufjs@7.6.6": true,
    "esbuild@0.21.5": true,
    "electron@31.0.0": true
  }
}
