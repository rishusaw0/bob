{
  "name": "jeeva-ai",
  "version": "1.0.4",
  "description": "JEEVA AI - Personal AI Assistant powered by Gemini",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "node server/index.js",
    "test": "node scripts/test.mjs",
    "dev": "concurrently \"npm run dev:react -- --mode desktop\" \"wait-on http://localhost:5173 && npm run dev:electron\"",
    "dev:react": "vite",
    "dev:electron": "electron .",
    "build": "vite build --mode public",
    "build:react": "vite build --mode public",
    "build:desktop": "vite build --mode desktop && electron-builder --win nsis --publish never",
    "test:phase5": "node scripts/phase5-reliability.mjs",
    "test:security": "node scripts/security-reliability.mjs"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "author": "Roushan Kumar",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rishusaw0/bob.git"
  },
  "type": "module",
  "dependencies": {
    "@google/genai": "^3.5.0",
    "highlight.js": "^11.12.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.1",
    "postcss": "^8.4.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.2.1",
    "react-markdown": "^9.0.1",
    "tailwindcss": "^3.4.3",
    "vite": "^8.4.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.roushan.jeeva-ai",
    "productName": "JEEVA AI",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "!electron/local-brain.cjs",
      "!electron/offline-voice.cjs",
      "!electron/win-voice.ps1",
      "public/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "electron/*.ps1",
      "public/icon.png"
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "JEEVA AI",
      "deleteAppDataOnUninstall": false,
      "uninstallDisplayName": "JEEVA AI ${version}",
      "artifactName": "JEEVA.AI.Setup.${version}.${ext}",
      "include": "build/installer.nsh"
    }
  },
  "allowScripts": {
    "protobufjs@7.6.6": true,
    "esbuild@0.21.5": true,
    "electron@45.5.0": true
  },
  "overrides": {
    "@electron/universal": {
      "minimatch": "^11.0.1"
    },
    "app-builder-lib": {
      "minimatch": "^11.0.1"
    }
  }
}
